# Copy to `.env` next to docker-compose.yml. These are BUILD-TIME values:
# Next.js bakes them into the JavaScript bundle, so changing any of them
# requires `docker compose up -d --build`.

# Leave empty unless the site is served from a sub-path.
PUBLIC_URL=

# Backend base URL, no trailing slash.
API_URL=https://api.asiapharmsg.com

# Google reCAPTCHA v3 SITE key. The matching SECRET key goes in the backend's
# .env as CAPTCHA_KEY. The registration must list asiapharmsg.com (and any
# staging hostname) under allowed domains.
CAPTCHA_KEY=

# EmailJS, used only by the contact page form.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
