# Site blocks for the host's Caddy (/etc/caddy/Caddyfile on the EC2 box).
# Caddy runs natively on the server, not in Docker, and already serves
# db.asiapharmsg.com. Add these blocks alongside it, then:
#   sudo systemctl reload caddy
#
# The frontend container publishes port 3000 on 127.0.0.1 only.

asiapharmsg.com, www.asiapharmsg.com {
    reverse_proxy 127.0.0.1:3000
    encode gzip
}

# Optional staging hostname pointing at the same container (or a second one
# on another port) while testing before cut-over.
# staging.asiapharmsg.com {
#     reverse_proxy 127.0.0.1:3000
# }
